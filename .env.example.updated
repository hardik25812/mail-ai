# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email Bison API Configuration
EMAIL_BISON_API_URL=https://api.emailbison.com/v1
EMAIL_BISON_API_KEY=your-email-bison-api-key

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key

# Slack Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-slack-webhook-url

# Dashboard URL for links in notifications
DASHBOARD_URL=https://your-dashboard-url.com

# Node Environment
NODE_ENV=production
