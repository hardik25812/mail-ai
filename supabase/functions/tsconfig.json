{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "types": [],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "https://deno.land/std@0.177.0/http/server.ts": ["./node_modules/@types/deno-std"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
