# Environment variables for Mail AI backend
# Copy this file to .env and fill in your values

# Supabase configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Email Bison API
EMAIL_BISON_API_KEY=your-email-bison-api-key

# n8n webhook for AI processing
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/mail-ai

# Sync API key for secure communication between services
SYNC_API_KEY=your-secure-sync-api-key
